{"$schema": "http://json-schema.org/draft-07/schema#", "title": "Figma library variables — значения переменных исходника по модам", "type": "object", "required": [ "schemaVersion", "libraryId", "extractedAt", "collections" ], "additionalProperties": false, "properties": { "schemaVersion": { "type": "string" }, "libraryId": { "type": "string" }, "source": { "type": "object" }, "extractedAt": { "type": "string" }, "note": { "type": "string" }, "collections": { "type": "object", "additionalProperties": { "type": "object", "required": [ "modes", "variables" ], "additionalProperties": false, "properties": { "key": { "type": "string" }, "modes": { "type": "array", "items": { "type": "string" } }, "variables": { "type": "object", "additionalProperties": { "type": "object", "required": [ "type", "values" ], "additionalProperties": false, "properties": { "type": { "type": "string", "enum": [ "COLOR", "FLOAT", "STRING", "BOOLEAN" ] }, "hidden": { "type": "boolean" }, "values": { "type": "array", "description": "по модам коллекции: #rrggbb[@alpha] | число | bool | строка | @Коллекция/имя | @ext:имя" } } } } } } }, "external": { "type": "object", "description": "цели внешних алиасов: имя → {key, library (libraryId пакета), collection (префикс id коллекции)}", "additionalProperties": { "type": "object", "required": [ "key" ], "properties": { "key": { "type": "string" }, "library": { "type": "string" }, "collection": { "type": "string" } } } } }}
